# Normalise line endings in the repository, checkout per platform.
* text=auto eol=lf

# Batch files MUST stay CRLF. LF-only endings silently break `goto` and
# `set /p`, which is exactly how startup.bat ended up with a dead menu.
*.bat text eol=crlf
*.cmd text eol=crlf

# Source and config
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.md text eol=lf
*.json text eol=lf

# Photographs are already compressed; never let git try to diff them.
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.avif binary
*.gif binary
*.mp4 binary